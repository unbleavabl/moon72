/*
 * Moon72: ZSA Moonlander default keymap (qmk zsa/moonlander/keymaps/default),
 * ported to ZMK. Edit here or live in ZMK Studio (https://zmk.studio, left
 * half on USB, unlock with the STUDIO key on MDIA).
 *
 * Not ported (no hardware / no ZMK equivalent): RGB keys, VRSN, WEBUSB_PAIR,
 * LED_LEVEL, TOGGLE_LAYER_COLOR. Their spots are &none.
 * Added on MDIA: Bluetooth profiles, USB/BLE output, bootloader on both halves.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYMB 1
#define MDIA 2

#define HYPR LS(LC(LA(LGUI)))
#define MEH LS(LC(LALT))

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp EQUAL      &kp N1   &kp N2        &kp N3   &kp N4   &kp N5 &kp LEFT          &kp RIGHT &kp N6 &kp N7   &kp N8    &kp N9  &kp N0           &kp MINUS
&kp DEL        &kp Q    &kp W         &kp E    &kp R    &kp T  &tog SYMB         &tog SYMB &kp Y  &kp U    &kp I     &kp O   &kp P            &kp BSLH
&kp BSPC       &kp A    &kp S         &kp D    &kp F    &kp G  &kp HYPR          &kp MEH   &kp H  &kp J    &kp K     &kp L   &lt MDIA SEMI    &mt LGUI SQT
&kp LSHFT      &mt LCTRL Z &kp X      &kp C    &kp V    &kp B                              &kp N  &kp M    &kp COMMA &kp DOT &mt RCTRL FSLH   &kp RSHFT
&lt SYMB GRAVE &none    &kp LA(LSHFT) &kp LEFT &kp RIGHT   &mt LALT K_APP        &mt RCTRL ESC    &kp UP   &kp DOWN  &kp LBKT &kp RBKT       &mo SYMB
                                      &kp SPACE &kp BSPC &kp LGUI                &kp LALT &kp TAB &kp RET
            >;
        };

        symb {
            display-name = "Symbols";
            bindings = <
&none   &kp F1      &kp F2    &kp F3    &kp F4    &kp F5    &trans       &trans &kp F6    &kp F7 &kp F8 &kp F9 &kp F10   &kp F11
&trans  &kp EXCL    &kp AT    &kp LBRC  &kp RBRC  &kp PIPE  &trans       &trans &kp UP    &kp N7 &kp N8 &kp N9 &kp STAR  &kp F12
&trans  &kp HASH    &kp DLLR  &kp LPAR  &kp RPAR  &kp GRAVE &trans       &trans &kp DOWN  &kp N4 &kp N5 &kp N6 &kp PLUS  &trans
&trans  &kp PRCNT   &kp CARET &kp LBKT  &kp RBKT  &kp TILDE                     &kp AMPS  &kp N1 &kp N2 &kp N3 &kp BSLH  &trans
&none   &trans      &trans    &trans    &trans        &none                &none          &trans &kp DOT &kp N0 &kp EQUAL &trans
                                        &none     &none     &none        &none  &trans    &trans
            >;
        };

        mdia {
            display-name = "Media";
            bindings = <
&bootloader &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR    &trans &trans &trans &trans &trans &trans &bootloader
&out OUT_TOG &trans &trans          &mmv MOVE_UP   &trans         &trans &trans             &trans &trans &trans &trans &trans &trans &trans
&trans &trans &mmv MOVE_LEFT        &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans            &trans &trans &trans &trans &trans &trans &kp C_PP
&trans &trans &trans                &trans         &trans         &trans                           &trans &trans &kp C_PREV &kp C_NEXT &trans &trans
&studio_unlock &trans &trans        &mkp LCLK      &mkp RCLK          &trans           &trans        &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &trans &trans
                                    &trans &trans &trans                               &trans &trans &trans
            >;
        };
    };
};
